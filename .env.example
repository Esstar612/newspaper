# MongoDB
# Get from: https://www.mongodb.com/cloud/atlas
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/newspaper

# News APIs: optional, the RSS pipeline needs neither.
# Used only by the dev-only manual ingest at /api/admin/ingest-news.
# NewsAPI: https://newsapi.org/
NEWS_API_KEY=your_newsapi_key
# New York Times: https://developer.nytimes.com/
NYT_API_KEY=your_nyt_api_key

# Weather API
# OpenWeatherMap: https://openweathermap.org/api
WEATHER_API_KEY=your_openweather_key

# Stock Market API
# Market Data: https://www.marketdata.app/
MARKET_DATA_API_TOKEN=your_market_data_key

# Cron security (optional, but the cron endpoints are open without it)
# Generate a random secret, for example: openssl rand -hex 16
CRON_SECRET=your_secret_key_here

# Guards the one-off admin backfill routes
ADMIN_INGEST_TOKEN=your_admin_token_here

# Datadog: cron metrics. Server only; never prefix with NEXT_PUBLIC_.
# Without a key, nothing is sent. Set both in Vercel Production only.
# API key: Organization Settings > API Keys. Site: datadoghq.com (US1), datadoghq.eu, and so on.
DD_API_KEY=your_datadog_api_key
DD_SITE=datadoghq.com

# Pinecone: article vectors for search. Server only; never prefix with NEXT_PUBLIC_.
# Create the index once with: node --env-file=.env.local scripts/pinecone-setup.mjs
# It prints PINECONE_INDEX_HOST. Set both in Vercel Production only.
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX_HOST=newspaper-articles-xxxxxxx.svc.aped-xxxx-xxxx.pinecone.io

# Anthropic: answers for /api/ask. Server only; set in Vercel Production only.
# Set a monthly spend limit in the Anthropic Console as the hard stop.
ANTHROPIC_API_KEY=your_anthropic_api_key
ASK_MODEL=claude-sonnet-5
